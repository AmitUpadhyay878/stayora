generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BrandTier {
  value
  mid
  premium
  leisure
}

enum BookingStatus {
  pending
}

model Brand {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  tagline     String
  description String
  tier        BrandTier
  createdAt   DateTime  @default(now())
  hotels      Hotel[]
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  country   String
  tagline   String
  heroImage String
  createdAt DateTime @default(now())
  hotels    Hotel[]
}

model User {
  id            String           @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  wishlistItems WishlistItem[]
  bookings      BookingRequest[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model Hotel {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  brandId           String
  brand             Brand              @relation(fields: [brandId], references: [id], onDelete: Restrict)
  cityId            String
  city              City               @relation(fields: [cityId], references: [id], onDelete: Cascade)
  description       String
  address           String
  phone             String
  email             String
  diningName        String
  diningBlurb       String
  contactBlurb      String
  pricePerNight     Int
  guests            Int
  rating            Float
  reviewCount       Int
  amenities         String[]
  images            String[]
  featured          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  reviews           Review[]
  roomCategories    RoomCategory[]
  galleryImages     GalleryImage[]
  nearbyAttractions NearbyAttraction[]
  wishlistItems     WishlistItem[]
  bookings          BookingRequest[]

  @@index([brandId])
  @@index([cityId])
  @@index([featured])
}

model RoomCategory {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  summary   String
  sizeSqFt  Int
  sleeps    Int
  bedType   String
  image     String
  view      String?
  priceFrom Int      @default(0)
  extras    String[]
  sortOrder Int      @default(0)

  @@unique([hotelId, slug])
  @@index([hotelId])
}

model GalleryImage {
  id        String @id @default(cuid())
  hotelId   String
  hotel     Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int    @default(0)

  @@index([hotelId])
}

model NearbyAttraction {
  id        String @id @default(cuid())
  hotelId   String
  hotel     Hotel  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name      String
  distance  String
  blurb     String
  sortOrder Int    @default(0)

  @@index([hotelId])
}

model Review {
  id        String   @id @default(cuid())
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  author    String
  avatar    String
  rating    Int
  body      String
  createdAt DateTime @default(now())

  @@index([hotelId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
  @@index([userId])
}

model BookingRequest {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotelId   String
  hotel     Hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  email     String
  checkIn   DateTime
  checkOut  DateTime
  guests    Int
  rooms           Int           @default(1)
  adults          Int           @default(1)
  children        Int           @default(0)
  roomPreference  String?
  extras          String[]      @default([])
  message         String?
  status    BookingStatus @default(pending)
  createdAt DateTime      @default(now())

  @@index([userId])
  @@index([hotelId])
}
